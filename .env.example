# ============================================
# Frontend (Next.js)
# ============================================
NEXT_PUBLIC_API_URL=http://backend:4000

# ============================================
# Backend (Node.js / Express)
# ============================================
PORT=4000
DATABASE_URL=postgresql://user:password@db.xxxx.supabase.co:5432/postgres
PYTHON_MICROSERVICE_URL=http://python-microservice:8000
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# JWT
JWT_SECRET=your_jwt_secret_here

# Public URL of the frontend (used to build affiliate signup links and e-mails)
FRONTEND_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_INDIVIDUAL=price_xxx
STRIPE_PRICE_INDIVIDUAL_YEARLY=price_xxx
STRIPE_PRICE_OFFICE=price_xxx
STRIPE_PRICE_OFFICE_YEARLY=price_xxx
# Shared coupon (10% off, repeating 2 months) that every affiliate promotion code points at.
# Leave blank on first run: the backend creates the coupon once and logs the id to paste here.
STRIPE_AFFILIATE_COUPON_ID=

# Discord ops alerts
DISCORD_ALERTS_ENABLED=true
DISCORD_ALERTS_ENABLED_IN=production
DISCORD_ALERTS_DEFAULT_USERNAME=BentiFiles Ops
DISCORD_ALERTS_TIMEOUT_MS=5000
DISCORD_WEBHOOK_SIGNUP=
DISCORD_WEBHOOK_BILLING=
DISCORD_WEBHOOK_ERRORS=
DISCORD_WEBHOOK_SECURITY=

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# Chave mestra de criptografia dos arquivos (32 bytes em base64).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PERDER ESTA CHAVE = PERDER TODOS OS ARQUIVOS. Guarde também no cofre de senhas.
STORAGE_MASTER_KEY_V1=
STORAGE_MASTER_KEY_CURRENT=1

# Worker de expurgo: use o session pooler do Supabase (porta 5432)
STORAGE_PURGE_DATABASE_URL=postgresql://user:password@aws-0-xxx.pooler.supabase.com:5432/postgres

# ============================================
# Python Microservice (FastAPI)
# ============================================
PORT=8000
